# Godot 4 官方推荐忽略项
# 参考 https://github.com/github/gitignore/blob/main/Godot.gitignore

# Godot 4+ 的缓存与导入目录（必须忽略，重新打开工程会自动生成）
.godot/

# Godot 3 遗留
.import/

# 导出相关
export.cfg
export_presets.cfg

# 自动生成的翻译文件
*.translation

# C# / Mono 用户
.mono/
data_*/
mono_crash.*.json

# 本地导出产物（不要把 exe/pck 提交进仓库）
build/
export/
*.pck

# 编辑器 / 系统垃圾
.DS_Store
Thumbs.db
*.swp
*~

# 本地测试输出
tmp/

# AI 助手的工作记忆（仅本地）
.workbuddy/
